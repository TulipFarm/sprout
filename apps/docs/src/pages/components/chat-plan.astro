---
import Docs from '../../layouts/Docs.astro';
import {
  ChatPlanCanvas,
  ChatPlanEmpty,
  ChatPlanLongContent,
  ChatPlanPlayground,
  ChatPlanStates,
} from '../../components/ChatPlanDemo';
import CodeBlock from '../../components/CodeBlock.astro';
---

<Docs
  title="Chat Plan"
  description="A plan an agent proposed in chat, with each step's progress and a count of completed steps."
>
  <h1 class="docs-title">Chat Plan</h1>
  <p class="docs-lead">
    A plan an agent proposed in chat. Each step shows if it is not started, in progress, complete, or failed. The header
    counts completed steps.
  </p>
  <div class="mt-8">
    <ChatPlanPlayground client:load />
  </div>
  <section class="prose-section">
    <h2 class="section-title">Usage</h2>
    <CodeBlock
      lang="tsx"
      title="A plan with one running step"
      code={`import { ChatPlan, type ChatPlanStep } from "@tulipfarm/sprout/chat-plan";

const steps: ChatPlanStep[] = [
  { id: "find", title: "Find deliveries with no supplier", state: "complete" },
  { id: "match", title: "Match each delivery to a supplier", state: "running" },
  { id: "update", title: "Update 42 delivery records", state: "pending" },
];

<ChatPlan title="Fill in missing suppliers" steps={steps} />`}
    />
    <ul>
      <li>
        <code>title</code>: the plan name. It also names the section.
      </li>
      <li>
        <code>steps</code>: <code>{'{ id, title, detail?, state }[]'}</code>, in order. <code>state</code> is{' '}
        <code>pending</code>,<code>running</code>, <code>complete</code>, or <code>error</code>.<code>detail</code> is
        one optional line under the title.
      </li>
    </ul>
    <p>Chat Plan has one look and one size. It fills the width it gets.</p>
  </section>
  <section class="prose-section">
    <h2 class="section-title">Step states</h2>
    <p>Complete shows a green check, in progress a spinner, failed a red warning, and not started a clock.</p>
    <div class="mt-4">
      <ChatPlanStates client:load />
    </div>
  </section>
  <section class="prose-section">
    <h2 class="section-title">Empty plan</h2>
    <p>With no steps, the plan says none were proposed yet.</p>
    <div class="mt-4">
      <ChatPlanEmpty client:load />
    </div>
  </section>
  <section class="prose-section">
    <h2 class="section-title">In the canvas</h2>
    <p>
      A to-do result opens in the <a href="/components/canvas/">Canvas</a>. Wrap the plan in <code>CanvasSection</code>{' '}
      with no title, so the plan's own title leads.
    </p>
    <CodeBlock
      lang="tsx"
      code={`<CanvasSection>
  <ChatPlan title={item.title} steps={item.steps} />
</CanvasSection>`}
    />
    <div class="mt-4">
      <ChatPlanCanvas client:load />
    </div>
  </section>
  <section class="prose-section">
    <h2 class="section-title">Long content</h2>
    <p>Long titles, links, and details wrap. The count moves below the title when space runs out.</p>
    <div class="mt-4">
      <ChatPlanLongContent client:load />
    </div>
  </section>
  <section class="prose-section">
    <h2 class="section-title">Accessibility</h2>
    <p>
      The plan is a <code>section</code> named by its title, which is an
      <code>h4</code>. Steps are an ordered list. Icons are hidden; each step ends with hidden text such as “In
      progress” or “Failed”, so screen readers hear the state.
    </p>
    <p>When a step changes state its icon fades in over 180ms; with reduced motion it changes at once.</p>
  </section>
  <section class="prose-section">
    <h2 class="section-title">Theme tokens</h2>
    <p>
      The border uses <code>--sprout-line</code>, muted text and pending icons
      <code>--sprout-muted</code>, complete icons
      <code>--sprout-success</code>, and failed icons
      <code>--sprout-danger</code>.
    </p>
  </section>
</Docs>
