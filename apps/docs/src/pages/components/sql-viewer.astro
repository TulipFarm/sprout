---
import Docs from "../../layouts/Docs.astro";
import {
  SqlViewerLayouts,
  SqlViewerPlayground,
} from "../../components/SqlViewerDemo";
import CodeBlock from "../../components/CodeBlock.astro";
---

<Docs
  title="SQL Viewer"
  description="A pannable, zoomable map of TulipFarm tables, their columns and keys, and the joins between them."
>
  <h1 class="docs-title">SQL Viewer</h1>
  <p class="docs-lead">
    Shows TulipFarm tables as SQL: one card per table, one row per column, and a
    line for each join. Hover or click a table or a foreign key to light up its
    joins. Up to four tables show at once; the rest wait behind a "+N tables"
    card.
  </p>
  <div class="mt-8"><SqlViewerPlayground client:load /></div>

  <section class="prose-section">
    <h2 class="section-title">Usage</h2>
    <CodeBlock
      lang="tsx"
      title="Show a team's tables"
      code={`import { SqlViewer } from "@tulipfarm/sprout/sql-viewer";

// Table documents straight from TulipFarm.
<SqlViewer
  tables={tableDocuments}
  groups={{ [salesTeamId]: "Sales", [billingTeamId]: "Billing" }}
  label="Tables in Sales"
/>`}
    />
    <p>
      The viewer fills its parent and is at least 24rem tall. Give the parent a
      height, such as <code>h-160</code>, to show more.
    </p>
  </section>

  <section class="prose-section">
    <h2 class="section-title">Columns and types</h2>
    <p>
      Every table starts with <code>id uuid</code>, its primary key. Text shows
      as <code>varchar(n)</code>, numbers as <code>numeric(p,s)</code>, and
      timestamps as <code>timestamptz</code>. Selects show as <code>enum</code>
      and list their options on hover. Relationships show as <code>uuid</code>
      or <code>uuid[]</code> with a link icon. Optional columns end in
      <code>?</code>. Single-column unique keys show a fingerprint; keys over
      several columns are listed under "Unique keys".
    </p>
  </section>

  <section class="prose-section">
    <h2 class="section-title">Layouts</h2>
    <p>
      <code>layout="auto"</code> uses columns from 768px up and a stack below it.
      Columns place each joined table one step right of the table that points to it.
      Pass <code>horizontal</code> or <code>vertical</code> to fix the layout.
    </p>
    <div class="mt-6"><SqlViewerLayouts client:load /></div>
  </section>

  <section class="prose-section">
    <h2 class="section-title">Props</h2>
    <ul>
      <li>
        <code>tables</code>: TulipFarm table definitions or documents with
        <code>id</code>, <code>label</code>, <code>owningTeamId</code>,
        <code>fields</code>, and <code>uniqueKeys</code>. A relationship to a
        table that is not passed is not drawn.
      </li>
      <li><code>label</code>: the accessible name of the viewer.</li>
      <li>
        <code>groups</code>: team names by <code>owningTeamId</code>. Each named
        team gets its own tinted frame.
      </li>
      <li>
        <code>maxVisible</code>: tables shown before the rest collapse. Default
        4.
      </li>
      <li>
        <code>layout</code>: <code>auto</code> (default), <code>horizontal</code
        >, or <code>vertical</code>.
      </li>
    </ul>
  </section>

  <section class="prose-section">
    <h2 class="section-title">Keyboard and accessibility</h2>
    <p>
      Tab moves to the viewer, then to each table, then to the zoom controls.
      Focus on a table lights its joins; <kbd>Enter</kbd> pins them and
      <kbd>Esc</kbd> clears. The arrow keys pan, <kbd>+</kbd> and <kbd>-</kbd>
      zoom, and <kbd>0</kbd> fits everything. Every join is also listed for screen
      readers, such as "Deals.customer_id joins Customers.id, many to one".
    </p>
  </section>

  <section class="prose-section">
    <h2 class="section-title">Theme tokens</h2>
    <p>
      Uses <code>--sprout-surface</code>, <code>--sprout-canvas</code>,
      <code>--sprout-line</code>, <code>--sprout-text</code>,
      <code>--sprout-muted</code>, and <code>--sprout-primary</code>. Team
      frames cycle through <code>--sprout-chart-1</code> to
      <code>--sprout-chart-5</code>.
    </p>
  </section>
</Docs>
